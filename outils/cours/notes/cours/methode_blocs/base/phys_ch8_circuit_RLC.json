  "enonces": {
    "lc_o1_carte": "Au national, quelles sont les deux questions presque toujours posées sur le RLC ?",
    "lc_o2_prerequis": "Dérive f(t) = cos(2πt/T₀).",
    "lc_d1_rc": "Au RC, pendant la décharge dans une résistance seule, u_C peut-elle devenir négative ?",
    "lc_d2_bobine": "u_C descend vers 0. Une fois arrivée à 0, que va-t-elle faire ?",
    "lc_d3_courant": "Au moment où u_C = 0, l'intensité i dans le circuit est :",
    "lc_d4_libres": "Pourquoi dit-on que ces oscillations sont « libres » ?",
    "lc_d5_signe": "Entre deux instants, u_C diminue. Quel est le signe de i ?",
    "lc_d6_depart": "E = 5 V. Juste après la bascule, que vaut u_b ?",
    "lc_r1_pseudo": "Le circuit contient une petite résistance (R + r = 20 Ω). Les sommets successifs de u_C vont-ils garder la même hauteur ?",
    "lc_r2_aperiodique": "On remplace R par une très grande résistance (R = 1 kΩ). u_C va-t-elle encore changer de signe ?",
    "lc_r3_ordre": "Range ces régimes du moins amorti au plus amorti.",
    "lc_r4_national": "2021 R : même bobine (r = 5 Ω), avec R₃ = 10 Ω ou avec R₄ = 100 Ω. Laquelle donne la courbe (b), très amortie ?",
    "lc_e1_additivite": "Après la bascule, le second membre de la loi d'additivité vaut-il E ou 0 ?",
    "lc_e2_remplacer": "Dans q/C + R·i + L·di/dt + r·i = 0, quels termes contiennent i sans dérivée ?",
    "lc_e3_equation_q": "Sachant que i = dq/dt, que vaut di/dt ?",
    "lc_e4_equation_uc": "On divise LC·d²u_C/dt² + (R + r)·C·du_C/dt + u_C = 0 par LC. Quel est le coefficient de du_C/dt ?",
    "lc_e5_lc_ideal": "Si R + r = 0, quel terme disparaît de l'équation, et les sommets de u_C baissent-ils encore ?",
    "lc_e6_sinusoide": "Sur la courbe u_C(t), entre quels points lit-on la période propre T₀ ?",
    "lc_e7_deriver": "Dérive −(2π/T₀)·U_m·sin(2πt/T₀ + φ) par rapport au temps.",
    "lc_e8_T0": "L = 0,1 H et C = 10 µF. Que vaut T₀ ?",
    "lc_p1_unites": "De la relation i = C·du/dt, quelle est la dimension de C ?",
    "lc_p2_charge": "On charge le condensateur sous 12 V au lieu de 6 V. La période propre T₀ change-t-elle ?",
    "lc_p3_influence": "On multiplie C par 4. La période propre T₀ est-elle multipliée par 4, par 2, ou inchangée ?",
    "lc_p4_national": "2022 N : E = 12 V, bobine de résistance nulle. Laquelle des trois courbes représente u_C ?",
    "lc_c1_depart": "Le condensateur chargé sous E est basculé dans la bobine : la courbe u_C(t) part de son maximum. Que vaut φ ?",
    "lc_c2_amplitude": "Sur un oscillogramme de u_C(t), un sommet est à 4 V et le creux suivant à −4 V. Que vaut U_m ?",
    "lc_c3_angles": "U_m = 6 V et u_C(0) = 3 V. Trouve les deux valeurs possibles de φ.",
    "lc_c4_sens": "U_m = 6 V ; la courbe u_C(t) part de 3 V en montant. Détermine φ.",
    "lc_l1_mesure": "Entre le 1er et le 4e sommet de u_C(t), on lit 12 ms. Que vaut la pseudo-période T ?",
    "lc_l2_voisine": "National 2021 R : L = 0,51 H, C = 100 µF ; on lit T = 45 ms. Calcule T₀ et compare.",
    "lc_l3_carre": "National 2020 N : T ≈ T₀ = 10 ms, L = 1 H, π² = 10. Calcule C.",
    "lc_l4_2023": "Une période de u_C(t) occupe 4 graduations de 0,5 ms ; L = 1 H ; π² = 10. Calcule C.",
    "lc_en1_reservoirs": "Laquelle de ces deux énergies dépend de l'intensité i ?",
    "lc_en2_depart": "National 2019 N : C = 10 µF chargé sous E = 10 V, puis basculé dans la bobine. Calcule l'énergie totale au départ.",
    "lc_en3_echange": "Dans le circuit LC, à l'instant où u_C = 0, où se trouve toute l'énergie ?",
    "lc_en4_somme": "National 2019 N : LC idéal, E = 5·10⁻⁴ J, C = 10 µF ; à t = 12 ms, u_C = −8 V. Calcule E_m à cet instant.",
    "lc_a1_joule": "Avant de voir : avec R + r = 20 Ω, l'énergie totale E du circuit reste-t-elle constante ?",
    "lc_a2_derivee": "Dérive ½·L·i² par rapport au temps.",
    "lc_a3_dEdt": "Quel est le signe de dE/dt = −(R + r)·i², et que fait l'énergie E ?",
    "lc_a4_perdue": "2016 N : C = 10 µF ; q = 120 µC à t = 0, puis q = 40 µC à t = 18 ms (deux sommets). Calcule l'énergie perdue entre ces deux instants.",
    "lc_a5_courbes": "Avant de voir : condensateur chargé à t = 0. Des deux courbes d'énergie, laquelle part de 0 ?",
    "lc_k1_entretien": "u_G = k·i. Si l'intensité i double, que devient la tension u_G ?",
    "lc_k2_k": "2020 N : R = 90 Ω, r = 10 Ω. Avant le calcul : quelle valeur de k rend les oscillations sinusoïdales ?",
    "lc_k3_T0": "Avant de voir : avec k = R + r, quelle est la période des oscillations entretenues ?",
    "lc_n1_2020N": "2020 N : L = 1 H, R = 90 Ω, r = 10 Ω, T = 10 ms (T ≈ T₀). Trouve C puis k₀ (π² = 10).",
    "lc_n2_2025N": "Avant de voir : entre t_A et t_B, u_C décroît. Quel est le signe de i = C₀·du_C/dt ?",
    "lc_bl_fiche": "Quelle formule donne la période propre T₀ du circuit LC ?",
    "lc_cr_carte": "Dans le circuit RLC, qui fait osciller le circuit, et qui amortit les oscillations ?"
  }
