  "enonces": {
    "su_o1_questions": "Dans un exercice de suites du national, quelle question vient en premier, presque toujours ?",
    "su_o2_bases": "u₀ = 5, suite géométrique de raison 1/2 : que vaut u₃ ?",
    "su_a1_liste": "Dans la case numéro 2, qu'y a-t-il ?",
    "su_a2_indice": "Si u₂ = 5, que vaut u₂ + 1 ? Connaît-on u₃ ?",
    "su_a3_termes": "u₀ = 3/2 et uₙ₊₁ = 2uₙ/(2uₙ + 5) : que vaut u₁ ?",
    "su_a4_arithmetique": "uₙ = 3n + 2 : que vaut uₙ₊₁ − uₙ, et que conclus-tu ?",
    "su_a5_terme_arith": "u₁ = 4 et r = 3 : écris uₙ en fonction de n.",
    "su_a6_geometrique": "uₙ = 5 × 2ⁿ : écris uₙ₊₁ en fonction de uₙ.",
    "su_a7_terme_geo": "v₀ = 1/2 et q = 1/7 : écris vₙ. Que vaut v₀ avec ta formule ?",
    "su_a8_nombre_termes": "De u₃ à u₁₀, combien de termes ?",
    "su_a9_sommes": "Calcule 1 + 2 + 4 + … + 2¹⁰.",
    "su_r1_dominos": "Si le domino 0 tombe mais qu'il manque le passage du 5 au 6, que se passe-t-il ?",
    "su_r2_trois_titres": "Dans l'hérédité, a-t-on le droit d'écrire « supposons que pour tout n, uₙ > 16 » ?",
    "su_r3_heredite_affine": "u₀ = 17, uₙ₊₁ = ¼uₙ + 12 : dans l'hérédité, partant de uₙ > 16, quelle est la première opération ?",
    "su_r4_heredite_fraction": "u₀ = 3 et uₙ₊₁ = (4uₙ + 3)/(3uₙ + 4) : pour montrer uₙ₊₁ > 1 dans l'hérédité, on étudie :",
    "su_r5_choisir": "uₙ₊₁ = (3uₙ − 8)/(2uₙ − 5) : quelle méthode pour montrer uₙ < 2 dans l'hérédité ?",
    "su_r6_ecriture_donnee": "Dans l'hérédité, tu as 3 ≤ 1 + uₙ ≤ 5. Quelle est l'étape suivante ?",
    "su_r7_strict_large": "Tu as montré uₙ₊₁ < 3 ; l'énoncé demande uₙ₊₁ ≤ 3. Est-ce bon ?",
    "su_r8_national": "Dans l'hérédité, uₙ₊₁ + 1 = ?",
    "su_b1_plancher": "Tu as montré uₙ > 16 pour tout n. Que peux-tu dire de la suite ?",
