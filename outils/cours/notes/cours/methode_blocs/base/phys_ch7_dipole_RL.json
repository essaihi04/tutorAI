    "rl_m1_montage": "Pourquoi visualise-t-on u_R pour voir i ?",
    "rl_m2_fermeture": "La courbe de i après la fermeture de K : un saut, une droite, ou une montée qui s'aplatit ?",
    "rl_m3_regimes": "Pendant le régime permanent, que vaut di/dt ?",
    "rl_m4_I0": "E = 12 V, R = 40 Ω, r = 8 Ω. Que vaut I₀ ?",
    "rl_e1_additivite": "Écris la loi d'additivité des tensions pour ce circuit.",
    "rl_e2_remplacer": "Dans R·i + L·di/dt + r·i = E, quels termes contiennent i sans dérivée ?",
    "rl_e3_equation": "Quand on regroupe R·i + L·di/dt + r·i = E, quel coefficient sera devant i ?",
    "rl_e4_formes": "Divise L·di/dt + (R + r)·i = E par R + r. Qu'obtiens-tu ?",
    "rl_e5_uR": "Remplace i par u_R/R dans L·di/dt + (R + r)·i = E, puis multiplie par R/L. Que trouves-tu ?",
    "rl_e6_ub": "Juste après la fermeture de K, que vaut u_b ?",
    "rl_e7_2021R": "Montre que i vérifie di/dt + (1/τ)·i = E/L et exprime τ.",
    "rl_e8_2019R": "En régime permanent U_R = 8 V, avec E = 10 V et R = 40 Ω. Que vaut r ?",
    "rl_s1_forme": "Quand t devient très grand, i(t) = A(1 − e^(−t/τ)) tend vers :",
    "rl_s2_deriver": "Dérive i(t) = A(1 − e^(−t/τ)). Que vaut di/dt ?",
    "rl_s3_tau": "De L/τ − (R + r) = 0, tire τ.",
    "rl_s4_A": "E = 6 V, R + r = 30 Ω. Que vaut A ?",
    "rl_s5_dimension": "De u = L·di/dt, quelle est la dimension de L ?",
    "rl_s6_pourcent": "I₀ = 0,25 A. Que vaut i à t = τ ?",
    "rl_s7_L": "On double L. La courbe i(t) monte-t-elle plus vite ou moins vite, et le palier change-t-il ?",
    "rl_s8_R": "On augmente R. Que deviennent I₀ et τ ?",
    "rl_t1_rupture": "À la rupture, écris l'équation différentielle vérifiée par i.",
    "rl_t2_descente": "I₀ = 0,2 A. Que vaut i à t = τ après la rupture ?",
    "rl_t3_diode": "À quoi sert la diode branchée en parallèle sur la bobine ?",
    "rl_t4_national": "Juste après l'ouverture, que vaut la tension u_b de la bobine ?",
    "rl_l1_tangente": "Avant de voir : où la tangente à l'origine coupe-t-elle l'asymptote ?",
    "rl_l2_pourcent": "U_R max = 5 V. À quelle hauteur trace-t-on l'horizontale pour lire τ ?",
    "rl_l3_r": "E = 6 V, R = 50 Ω, U_R max = 5 V. Trouve r.",
    "rl_l4_L": "τ = 2 ms, R + r = 60 Ω. Que vaut L ?",
    "rl_l5_droite": "Avant de voir : sur la droite di/dt = f(i), où lit-on I₀ ?",
