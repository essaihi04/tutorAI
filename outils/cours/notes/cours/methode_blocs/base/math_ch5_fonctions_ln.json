  "enonces": {
    "ln_o1": "Au national (20 sujets, 2016-2025), dans combien de sujets trouve-t-on ln ?",
    "ln_o2": "−2x > 4 : que peut-on dire de x ?",
    "ln_n1": "On applique la règle xⁿ → xⁿ⁺¹/(n + 1) à x⁻¹ : par quoi faut-il diviser ?",
    "ln_n2": "x ↦ 1/x est continue sur ]0 ; +∞[ : que peut-on en déduire ?",
    "ln_n3": "Dans la famille F + k des primitives de 1/x, combien de courbes passent par le point (1 ; 0) ?",
    "ln_n4": "Que vaut la dérivée de ln en x = 2 ?",
    "ln_c1": "Si 0 < a < b, lequel est le plus grand ?",
    "ln_c2": "ln(3/4) est :",
    "ln_c3": "Entre quels entiers consécutifs se trouve e ?",
    "ln_c4": "ln x < ln 5 : que peut-on dire de x ?",
    "ln_c5": "L'équation de la tangente à la courbe de ln au point d'abscisse 1 est :",
    "ln_d1": "f(x) = ln(2x − 6) : quel est D_f ?",
    "ln_d2": "f(x) = ln(5x/(3 − x)) : quel est D_f ?",
    "ln_d3": "f(x) = (1 + ln x)/ln x : quel est D_f ?",
    "ln_d4": "f(x) = ln|x − 2| : quel est D_f ?",
    "ln_a1": "ln 2 ≈ 0,69 et ln 5 ≈ 1,61 : que vaut ln 10 environ ?",
    "ln_a2": "De combien faut-il monter la courbe de ln pour obtenir celle de x ↦ ln(3x) ?",
    "ln_a3": "Écris ln(1/8) en fonction de ln 2.",
    "ln_a4": "Écris ln(√2 × 8) en fonction de ln 2.",
    "ln_a5": "A = ln 12 − ln 27 + ln √2 = ?",
    "ln_a6": "ln(x²) = 2 ln x est-il vrai pour x = −1 ?",
    "ln_a7": "B = ln 16 − ln 27 + 3 ln 36 − ln √2 : quelle est la bonne valeur ?",
    "ln_a8": "Que vaut ln(1/e) ?",
    "ln_q1": "Résous ln(x − 1) + ln(x + 2) = ln 4.",
    "ln_q2": "Résous ln(2x − 1) = 1.",
    "ln_q3": "Résous ln(2x − 1) < 0.",
    "ln_q4": "Résous (ln x)² − ln x − 2 = 0.",
    "ln_q5": "Résous dans ]0 ; +∞[ : 2x ln x − 2x = 0.",
    "ln_q6": "Résous : ln x + ln y = 3 et ln x − ln y = 1.",
    "ln_q7": "Trouve le plus petit entier n tel que (1/4)ⁿ < 10⁻⁴.",
    "ln_l1": "Quel x faut-il pour que ln x dépasse 10 ?",
    "ln_l2": "La courbe de ln coupe-t-elle l'axe des ordonnées ?",
    "ln_l3": "Que vaut à peu près ln(1000)/1000 ?",
    "ln_l4": "Pour x proche de 0 (x > 0), x ln x est :",
    "ln_l5": "Calcule lim_{x→0} ln(1 + 2x)/x.",
    "ln_l6": "Calcule lim_{x→+∞} (x − ln x).",
    "ln_l7": "lim_{x→+∞} (ln x)²/x = ?",
    "ln_l8": "f(x) = 2x ln x − 2x et f(0) = 0 : f est-elle continue à droite en 0 ?",
    "ln_v1": "Dérive f(x) = ln(x² + 1) sur ℝ.",
    "ln_v2": "Dérive f(x) = x + ½ − ln x + ½(ln x)² sur ]0 ; +∞[.",
    "ln_v3": "f'(x) = (1 − ln x)/x² sur ]0 ; +∞[ : où f'(x) est-il positif ?",
    "ln_p1": "Une primitive de f(x) = 2x/(x² + 1) sur ℝ est :",
    "ln_p2": "Une primitive de f(x) = 1/(x − 3) sur ]−∞ ; 3[ est :",
    "ln_p3": "H(x) = x ln x − x est-elle une primitive de h(x) = ln x sur ]0 ; +∞[ ?",
