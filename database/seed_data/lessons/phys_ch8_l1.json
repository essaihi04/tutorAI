        "card": 1,
        "title": "Pulsation propre",
        "idea": "Sans amortissement, L et C échangent leur énergie.",
        "formula": "ω₀ = 1/√LC",
        "max_words": 28
      },
      {
        "card": 2,
        "title": "Amortissement",
        "idea": "R dissipe l’énergie par effet Joule.",
        "formula": "α = R/(2L)",
        "max_words": 28
      },
      {
        "card": 3,
        "title": "Régimes",
        "idea": "La comparaison entre α et ω₀ sépare oscillation et retour apériodique.",
        "formula": "Rcrit = 2√(L/C)",
        "max_words": 28
      }
    ],
