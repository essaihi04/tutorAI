      },
      {
        "step": 2,
        "phase": "prédire",
        "student_action": "Changer m et k puis prévoir f₀.",
        "evidence": "Une prédiction justifiée avant le calcul."
      },
      {
        "step": 3,
        "phase": "manipuler",
        "student_action": "Balayer f sous, près et au-dessus de f₀.",
