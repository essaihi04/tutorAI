      {
        "step": 5,
        "phase": "réinvestir",
        "student_action": "Répondre au défi et au ticket de sortie sans indice.",
        "evidence": "Deux réponses correctes sur trois."
      }
    ],
    "micro_enseignements": [
      {
        "card": 1,
        "title": "Oscillateur harmonique",
        "idea": "La force de rappel est proportionnelle à l’élongation.",
        "formula": "mx'' + kx = 0",
        "max_words": 28
      },
      {
        "card": 2,
        "title": "Fréquence propre",
        "idea": "Elle dépend de la masse et de la raideur.",
        "formula": "f₀ = (1/2π)√(k/m)",
        "max_words": 28
      },
      {
        "card": 3,
        "title": "Résonance",
        "idea": "L’amplitude devient maximale près de la fréquence propre.",
        "formula": "f ≈ f₀",
        "max_words": 28
      }
    ],
