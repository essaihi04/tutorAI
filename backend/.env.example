# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_tutor_bac
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/ai_tutor_bac

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Academy Darija-FR TTS (modele fine-tune auto-heberge : Colab + tunnel)
# API FastAPI : POST /tts (renvoie du WAV), GET /health, GET /voices.
# L'URL du tunnel ET le jeton changent a CHAQUE redemarrage du notebook Colab :
# recopie les deux valeurs affichees par la cellule 5 (« API PRETE »), ou lance
#   python scripts/set_academy_tts.py <url> <jeton>
# qui met ces lignes a jour et verifie que l'API repond.
ACADEMY_TTS_URL=https://votre-tunnel.trycloudflare.com
ACADEMY_TTS_TOKEN=votre-jeton
ACADEMY_TTS_VOICE=prof_faress
ACADEMY_TTS_NORMALISER=1
# 0 = TTS serveur actif, 1 = coupe (aucun cout, la voix passe au navigateur)
TTS_DISABLED=0

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
