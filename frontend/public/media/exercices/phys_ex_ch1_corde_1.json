    "questions": [
      {
        "id": "1",
        "texte": "Calculer la célérité v de l'onde le long de la corde.",
        "texte_dit": "السؤال un: حسب la célérité v ديال l'onde فla corde.",
        "reponse": {
          "type": "valeur",
          "grandeur": "v",
          "valeur": 1,
          "unite": "m/s",
          "tolerance": 0.03,
          "attendu": "v = SP/t₁ = 0,6/0,6 = 1 m/s"
        },
        "clavier": {
          "aides": [
            "v = d/Δt",
            "SP",
            "t₁",
            "m/s",
            "A.N. :"
          ],
          "pieges": [
            "v = Δt/d",
            "km/h"
          ]
        },
        "aides": [
          {
            "texte": "Pendant la durée t₁, le front est parti de S et il est arrivé en P : quelle distance a-t-il parcourue ?",
            "dit": "شوف la figure: من t égale zéro حتى t un، le front خرج من S ووصل ل P. شحال قطع ديال la distance؟",
            "audio": "/media/audio/exercices/phys_ex_ch1_corde_1/aides/q1_a1_v1.mp3"
          },
          {
            "texte": "La célérité est la distance parcourue par le front divisée par la durée : v = SP/t₁.",
            "dit": "la célérité هي la distance اللي قطع le front، على la durée. إذن v égale SP sur t un. عوض بالقيم.",
            "audio": "/media/audio/exercices/phys_ex_ch1_corde_1/aides/q1_a2_v1.mp3"
          }
        ],
        "correction": {
          "lignes": [
            {
              "texte": "1 : le front parcourt SP pendant la durée t₁",
              "mot": "le front قطع SP"
            },
            {
              "texte": "v = SP/t₁ = 0,6/0,6",
              "mot": "v égale SP sur t un"
            },
            {
              "texte": "v = 1 m/s",
              "mot": "v égale un mètre par seconde"
            }
          ],
          "parole": "السؤال un. من t égale zéro حتى t un، le front قطع SP. إذن v égale SP sur t un، يعني zéro virgule six sur zéro virgule six. v égale un mètre par seconde.",
          "audio": "/media/audio/exercices/phys_ex_ch1_corde_1/corrections/q1_v1.mp3"
        },
        "explication": "ex_c1",
        "facile": "fa_c1",
        "texte_audio": "/media/audio/exercices/phys_ex_ch1_corde_1/enonce/q1_v1.mp3"
      },
      {
        "id": "2",
        "texte": "Un point M de la corde est à la distance SM = 0,8 m de S. Calculer le retard τ du mouvement de M par rapport à celui de S.",
        "texte_dit": "السؤال deux: النقطة M بعيدة على S ب SM égale zéro virgule huit mètre. حسب le retard tau ديال M بالنسبة ل S.",
        "reponse": {
          "type": "valeur",
          "grandeur": "τ",
          "valeur": 0.8,
          "unite": "s",
          "tolerance": 0.03,
          "attendu": "τ = SM/v = 0,8/1 = 0,8 s"
        },
        "clavier": {
          "aides": [
            "τ = SM/v",
            "SM",
            "v",
            "s",
            "A.N. :"
          ],
          "pieges": [
            "τ = v/SM",
            "τ = SM·v"
          ]
        },
        "aides": [
          {
            "texte": "M refait le mouvement de S plus tard : le retard est la durée que met le front pour aller de S à M.",
            "dit": "M كدير نفس الحركة ديال S، ولكن من بعد. le retard هو la durée اللي كياخد le front باش يمشي من S ل M.",
            "audio": "/media/audio/exercices/phys_ex_ch1_corde_1/aides/q2_a1_v1.mp3"
          },
          {
            "texte": "Pendant τ, le front parcourt SM à la célérité v : τ = SM/v.",
            "dit": "فهاد la durée، le front كيقطع SM بla célérité v. إذن tau égale SM sur v.",
            "audio": "/media/audio/exercices/phys_ex_ch1_corde_1/aides/q2_a2_v1.mp3"
          }
        ],
        "correction": {
          "lignes": [
            {
              "texte": "2 : le front va de S à M pendant τ",
              "mot": "le front كيمشي من S ل M"
            },
            {
              "texte": "τ = SM/v = 0,8/1",
              "mot": "tau égale SM sur v"
            },
            {
              "texte": "τ = 0,8 s",
              "mot": "tau égale zéro virgule huit seconde"
            }
          ],
          "parole": "السؤال deux. le front كيمشي من S ل M فla durée tau. إذن tau égale SM sur v، يعني zéro virgule huit sur un. tau égale zéro virgule huit seconde.",
          "audio": "/media/audio/exercices/phys_ex_ch1_corde_1/corrections/q2_v1.mp3"
        },
        "explication": "ex_c2",
        "facile": "fa_c2",
        "texte_audio": "/media/audio/exercices/phys_ex_ch1_corde_1/enonce/q2_v1.mp3"
      },
      {
        "id": "3",
        "texte": "Calculer la longueur ℓ de la perturbation sur la corde.",
        "texte_dit": "السؤال trois: حسب la longueur L ديال la perturbation فوق la corde.",
        "reponse": {
          "type": "valeur",
          "grandeur": "ℓ",
          "valeur": 0.4,
          "unite": "m",
          "tolerance": 0.03,
          "attendu": "ℓ = v·θ = 1 × 0,4 = 0,4 m"
        },
        "clavier": {
          "aides": [
            "ℓ = v·θ",
            "θ",
            "v",
            "m",
            "A.N. :"
          ],
          "pieges": [
            "ℓ = v/θ",
            "ℓ = θ/v"
          ]
        },
        "aides": [
          {
            "texte": "La perturbation dure θ : pendant θ, son début a déjà avancé ; la longueur est la distance entre son début et sa fin.",
            "dit": "la perturbation كتدوم teta. فهاد la durée، البداية ديالها كتكون مشات. la longueur هي la distance بين البداية والنهاية ديالها.",
            "audio": "/media/audio/exercices/phys_ex_ch1_corde_1/aides/q3_a1_v1.mp3"
          },
          {
            "texte": "Pendant θ, le front avance de v·θ : ℓ = v·θ.",
            "dit": "فla durée teta، le front كيقطع v fois teta. إذن L égale v fois teta.",
            "audio": "/media/audio/exercices/phys_ex_ch1_corde_1/aides/q3_a2_v1.mp3"
          }
        ],
        "correction": {
          "lignes": [
            {
              "texte": "3 : pendant θ, le front avance de v·θ",
              "mot": "le front كيقطع v fois teta"
