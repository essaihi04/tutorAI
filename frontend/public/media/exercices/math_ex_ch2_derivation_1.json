        "id": "1",
        "texte": "En utilisant la limite du taux d'accroissement, montrer que f est dérivable en 1 et calculer f′(1).",
        "texte_dit": "السؤال un: باستعمال la limite ديال le taux d'accroissement، بين بلي f dérivable en un، وحسب f prime de un.",
        "reponse": {
          "type": "valeur",
          "grandeur": "f′(1)",
          "valeur": 3,
          "tolerance": 0.001,
          "attendu": "f(1) = 0 ; (f(x) − f(1))/(x − 1) = (x − 1)(x + 2)/(x − 1) = x + 2 ; la limite en 1 vaut 3 : f est dérivable en 1 et f′(1) = 3"
        },
        "clavier": {
          "aides": [
            "f(1) =",
            "(f(x) − f(1))/(x − 1)",
            "(x − 1)(x + 2)",
            "lim",
            "f′(1) =",
            "x + 2",
            "x ≠ 1",
            "0/0",
            "forme indéterminée",
            "x → 1",
            "∈ ℝ",
            "donc",
            "f est dérivable en 1"
          ],
          "pieges": [
            "0/0 = 0",
            "f′(1) = 2x + 1",
            "f′(1) = f(1)"
          ]
        },
        "aides": [
